# ==============================================================================
# Rikkei Lab - MySQL Environment Configuration Example
# ==============================================================================
# Host port mapping (Default 3306 is occupied by existing local service on host, using 3307)
MYSQL_PORT=3307

# MySQL Database Name
MYSQL_DATABASE=rikkei_lab

# Application User Credentials
MYSQL_USER=rikkei_user
MYSQL_PASSWORD=RikkeiSecurePassword2026!

# Root User Password
MYSQL_ROOT_PASSWORD=RikkeiRootPassword2026!
